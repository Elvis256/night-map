{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FAFAFB" },
      "foreground": { "$value": "#0B0B0F" },
      "border": { "$value": "#E8E8EE" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#0B0B0F" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#0B0B0F" },
      "primary": {
        "$value": "#FF4E62",
        "$description": "NightMap coral: primary actions and emphasis."
      },
      "primaryForeground": { "$value": "#0B0B0F" },
      "secondary": { "$value": "#F1F1F4" },
      "secondaryForeground": { "$value": "#1A1A22" },
      "muted": { "$value": "#F1F1F4" },
      "mutedForeground": { "$value": "#6B6B78" },
      "accent": { "$value": "#FF8A3D" },
      "accentForeground": { "$value": "#0B0B0F" },
      "destructive": { "$value": "#C6283D" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#E8E8EE" },
      "ring": { "$value": "#FF4E62" },
      "chart1": { "$value": "#FF4E62" },
      "chart2": { "$value": "#FF8A3D" },
      "chart3": { "$value": "#1FBF6B" },
      "chart4": { "$value": "#3DA9FF" },
      "chart5": { "$value": "#7A3CFF" },
      "sidebar": { "$value": "#FAFAFB" },
      "sidebarForeground": { "$value": "#0B0B0F" },
      "sidebarBorder": { "$value": "#E8E8EE" },
      "sidebarPrimary": { "$value": "#FF4E62" },
      "sidebarPrimaryForeground": { "$value": "#0B0B0F" },
      "sidebarAccent": { "$value": "#F1F1F4" },
      "sidebarAccentForeground": { "$value": "#1A1A22" },
      "sidebarRing": { "$value": "#FF4E62" }
    },
    "dark": {
      "background": { "$value": "#0B0B0F" },
      "foreground": { "$value": "#F3F4F6" },
      "border": { "$value": "#2A3045" },
      "card": { "$value": "#161923" },
      "cardForeground": { "$value": "#F3F4F6" },
      "popover": { "$value": "#161923" },
      "popoverForeground": { "$value": "#F3F4F6" },
      "primary": { "$value": "#FF4E62" },
      "primaryForeground": { "$value": "#0B0B0F" },
      "secondary": { "$value": "#1C2030" },
      "secondaryForeground": { "$value": "#F3F4F6" },
      "muted": { "$value": "#1C2030" },
      "mutedForeground": { "$value": "#AAB3C5" },
      "accent": { "$value": "#FF8A3D" },
      "accentForeground": { "$value": "#0B0B0F" },
      "destructive": { "$value": "#FF4E62" },
      "destructiveForeground": { "$value": "#0B0B0F" },
      "input": { "$value": "#1C2030" },
      "ring": { "$value": "#FF4E62" },
      "chart1": { "$value": "#FF4E62" },
      "chart2": { "$value": "#FF8A3D" },
      "chart3": { "$value": "#1FBF6B" },
      "chart4": { "$value": "#3DA9FF" },
      "chart5": { "$value": "#7A3CFF" },
      "sidebar": { "$value": "#0B0B0F" },
      "sidebarForeground": { "$value": "#F3F4F6" },
      "sidebarBorder": { "$value": "#2A3045" },
      "sidebarPrimary": { "$value": "#FF4E62" },
      "sidebarPrimaryForeground": { "$value": "#0B0B0F" },
      "sidebarAccent": { "$value": "#1C2030" },
      "sidebarAccentForeground": { "$value": "#F3F4F6" },
      "sidebarRing": { "$value": "#FF4E62" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "NightMap's common rounded-card radius; smaller and larger steps derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
